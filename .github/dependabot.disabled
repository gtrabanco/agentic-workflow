# Dependabot configuration for agentic-workflow.
# Monorepo (bun workspaces) + GitHub Actions.
#
# Uses bun ecosystem (GA since 2025-02-13) to read package.json and update
# bun.lock.  Each workspace package is monitored separately so that real
# external dependencies (typebox, ajv, typescript…) generate their own PRs,
# while cross-references to other workspace packages are ignored — those
# versions are controlled by publish.yml, which bumps all three together.
#
# STATUS: DISABLED — pin-watch --file-pr is the preferred path.
# Keep this file commented out so it can be recovered if needed.
# version: 2
# enable-beta-ecosystems: true
