{
  // The approved commit identity for this repository (issue #514).
  // `enforce: "push"` makes the local gate's push-identity step verify every
  // author and committer of a push range; the pre-commit hook is not installed
  // in this checkout, so the commit half stays out of the way.
  "gitIdentity": {
    "enforce": "off",
    "agentGuard": {
      "mode": "deny"
    }
  },
  // Per-unit cost measurement (issue #383): this repo opted out.
  // The JSONL path is the shipped default (.pi/.telemetry/sessions.jsonl, gitignored).
  "telemetry": {
    "enabled": true
  }
}
