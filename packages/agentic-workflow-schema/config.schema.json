{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gtrabanco/agentic-workflow/config.schema.json",
  "title": "agentic-workflow config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logSession": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Append the mechanical entry to docs/LOGS.md."
            },
            "publisher": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000
                }
              }
            }
          }
        }
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engram": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "jsonFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "description": "One disposition per guard: allow (the guard stands down), deny (it refuses without asking) or ask (it asks when the host has a UI, and denies when it cannot). `default` is what every guard falls back to; a guard's own `mode` overrides it. Guards that can be configured here: gitIdentity, toolChoice, receipt. Always on and not configurable: pathProtection (tighten-only) and contentGuard (no bypass).",
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "ask"
          ],
          "description": "The disposition every guard falls back to when its own entry declares no mode. Shipped: ask."
        },
        "gitIdentity": {
          "type": "object",
          "additionalProperties": false,
          "description": "The agent-side `git config` write guard (issue #514). `ask` can really ask; a headless session is denied.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            }
          }
        },
        "toolChoice": {
          "type": "object",
          "additionalProperties": false,
          "description": "The command-time `rg`/`bun` carrier (issue #610). This guard cannot ask, so `ask` answers as `deny`.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "description": "The inline PR-receipt guard (issue #182). This guard cannot ask, so `ask` answers as `deny`.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "ask"
              ]
            }
          }
        }
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The approved commit identity and the agent-side config-write guard.",
      "properties": {
        "enforce": {
          "type": "string",
          "enum": [
            "off",
            "commit",
            "push",
            "push-upstream",
            "commit-and-push",
            "commit-and-push-upstream"
          ]
        },
        "approved": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only the declared facts are verified; an absent field is not checked.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "git user.name, matched case-insensitively."
            },
            "email": {
              "type": "string",
              "minLength": 3,
              "description": "git user.email, matched case-insensitively."
            },
            "fullName": {
              "type": "string",
              "minLength": 1,
              "description": "The legal name a signing key's UID must carry."
            },
            "format": {
              "type": "string",
              "enum": [
                "openpgp",
                "ssh"
              ]
            },
            "signingKey": {
              "type": "string",
              "minLength": 1,
              "description": "The resolved signing key: key id, fingerprint or path."
            },
            "signingKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "description": "The per-machine keys: a resolved key matching any of these is approved (issue #546)."
            },
            "signing": {
              "type": "string",
              "enum": [
                "required",
                "allowed",
                "off"
              ],
              "description": "required: a commit must carry a signature from an approved key. allowed (default): signing is optional, and a resolved key is verified when one resolves. off: the project approves unsigned commits, so a signed one is refused."
            }
          }
        },
        "agentGuard": {
          "type": "object",
          "additionalProperties": false,
          "description": "The model-facing half of the identity guard: the config keys the agent may write without asking.",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 64,
              "description": "Config keys the agent may write without asking (e.g. user.name)."
            }
          }
        }
      }
    },
    "advance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterationsCap": {
          "type": "integer",
          "minimum": 1
        },
        "sensitivePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securityPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runLogPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pathProtection": {
      "type": "object",
      "additionalProperties": false,
      "description": "A tighten-only override: the shipped floor is always kept.",
      "properties": {
        "protectedGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre-freeze": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "modify": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "delete": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "rename": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                }
              }
            },
            "post-freeze": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "modify": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "delete": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "rename": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                }
              }
            },
            "always": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "modify": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "delete": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                },
                "rename": {
                  "type": "string",
                  "enum": [
                    "none",
                    "justification",
                    "approval"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "contentGuard": {
      "type": "object",
      "additionalProperties": false,
      "description": "Author-provenance policy for third-party forge content: which authors are ingested as readable content.",
      "properties": {
        "trustedRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER",
              "COLLABORATOR",
              "CONTRIBUTOR",
              "FIRST_TIME_CONTRIBUTOR",
              "FIRST_TIMER",
              "MANNEQUIN",
              "NONE"
            ]
          },
          "maxItems": 8,
          "description": "The author associations whose content may be ingested; every other association is excluded and declared."
        },
        "allowLogins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Logins admitted regardless of association — an explicit, reviewable exception list."
        },
        "denyLogins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Logins excluded regardless of association; a deny always beats an allow."
        }
      }
    }
  }
}
