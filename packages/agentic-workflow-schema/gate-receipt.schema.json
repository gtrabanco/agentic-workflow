{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gtrabanco/agentic-workflow/packages/agentic-workflow-schema/gate-receipt.schema.json",
  "title": "agentic-workflow machine gate receipt v1",
  "description": "The project verification gate's output as a document (issue #409): bounded per-check verdicts, failing fragments only, and a declared content manifest whose digest is the validity criterion — the HEAD sha under `provenance` says where the run happened, never whether the evidence still holds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "schema",
    "verdict",
    "degraded",
    "provenance",
    "manifest",
    "gate",
    "checks"
  ],
  "properties": {
    "contract": {
      "const": "agentic-workflow/gate-receipt"
    },
    "version": {
      "const": 1
    },
    "schema": {
      "const": "gate-receipt@1"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "degraded"
      ]
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "manifest": {
      "$ref": "#/definitions/manifest"
    },
    "gate": {
      "$ref": "#/definitions/gate"
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/check"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "degraded": {
            "maxItems": 0,
            "type": "array"
          },
          "checks": {
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "degraded": {
            "maxItems": 0,
            "type": "array"
          },
          "checks": {
            "contains": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "degraded"
          }
        }
      },
      "then": {
        "properties": {
          "degraded": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ],
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha",
        "generated_at",
        "gate_command"
      ],
      "properties": {
        "head_sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            }
          ]
        },
        "generated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
        },
        "gate_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "entries"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "(^/|\\\\|\\u0000|(^|/)\\.\\.(/|$))"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "duration_ms",
        "log_ref"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "log_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "exit_code",
        "duration_ms",
        "fragments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fragments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
