{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gtrabanco/agentic-workflow/packages/agentic-workflow-schema/guard-verdict.schema.json",
  "title": "agentic-workflow guard verdict v1",
  "description": "The fail-closed answer a workflow guard returns: allow, block (with the requirement, the enforcing command and a teaching message), or a declared degradation that names its fallback. Source of truth: @gtrabanco/agentic-workflow-schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "guard", "verdict"],
  "properties": {
    "contract": { "const": "agentic-workflow/guard-verdict" },
    "version": { "const": 1 },
    "guard": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "verdict": { "enum": ["allow", "block", "degrade"] },
    "reason": { "enum": ["rule-violation", "guard-unavailable", "guard-error", "config-invalid"] },
    "requirement": { "type": "string", "minLength": 1 },
    "enforcingCommand": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["verdict"], "properties": { "verdict": { "const": "allow" } } },
      "then": {
        "not": {
          "anyOf": [
            { "type": "object", "required": ["reason"], "properties": { "reason": true } },
            { "type": "object", "required": ["requirement"], "properties": { "requirement": true } },
            { "type": "object", "required": ["enforcingCommand"], "properties": { "enforcingCommand": true } },
            { "type": "object", "required": ["message"], "properties": { "message": true } }
          ]
        }
      }
    },
    {
      "if": { "type": "object", "required": ["verdict"], "properties": { "verdict": { "const": "block" } } },
      "then": { "required": ["reason", "requirement", "enforcingCommand", "message"] }
    },
    {
      "if": { "type": "object", "required": ["verdict"], "properties": { "verdict": { "const": "degrade" } } },
      "then": { "required": ["reason", "message"] }
    }
  ]
}
