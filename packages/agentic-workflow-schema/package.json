{
  "name": "@gtrabanco/agentic-workflow-schema",
  "version": "4.0.1",
  "description": "Versioned machine contracts, JSON Schemas, parsers, and deterministic document snapshots for agentic-workflow orchestration.",
  "keywords": [
    "agentic-workflow",
    "agent",
    "orchestration",
    "skills",
    "schema",
    "envelope"
  ],
  "license": "MIT",
  "author": "Gabriel Trabanco <gtrabanco@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtrabanco/agentic-workflow.git",
    "directory": "packages/agentic-workflow-schema"
  },
  "homepage": "https://github.com/gtrabanco/agentic-workflow/blob/main/docs/workflow/ORCHESTRATION.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope.schema.json": "./envelope.schema.json",
    "./skill-outcome.schema.json": "./skill-outcome.schema.json",
    "./workflow-snapshot.schema.json": "./workflow-snapshot.schema.json",
    "./candidate-snapshot.schema.json": "./candidate-snapshot.schema.json",
    "./review-receipt.schema.json": "./review-receipt.schema.json",
    "./verification-receipt.schema.json": "./verification-receipt.schema.json",
    "./verification-plan.schema.json": "./verification-plan.schema.json",
    "./pre-execution-artifact-snapshot.schema.json": "./pre-execution-artifact-snapshot.schema.json",
    "./pre-execution-review-receipt.schema.json": "./pre-execution-review-receipt.schema.json"
  },
  "files": [
    "dist",
    "envelope.schema.json",
    "skill-outcome.schema.json",
    "workflow-snapshot.schema.json",
    "candidate-snapshot.schema.json",
    "review-receipt.schema.json",
    "verification-receipt.schema.json",
    "verification-plan.schema.json",
    "pre-execution-artifact-snapshot.schema.json",
    "pre-execution-review-receipt.schema.json",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "check:verification-schemas": "tsc && node scripts/generate-verification-schemas.mjs --check",
    "check:verification-package": "node scripts/check-verification-package.mjs",
    "check:pre-execution-schemas": "tsc && node scripts/generate-pre-execution-schemas.mjs --check",
    "check:pre-execution-package": "node scripts/check-pre-execution-package.mjs",
    "test:pre-execution-docs": "node --test test/pre-execution-docs.test.mjs",
    "bench:verification": "node scripts/bench-verification.mjs",
    "probe:sha256-paths": "node scripts/probe-sha256-paths.mjs",
    "test:verification-docs": "node --test test/verification-docs.test.mjs",
    "gate:verification": "npm test && npm run check:verification-schemas && npm run check:verification-package && npm run test:verification-docs && npm run bench:verification -- --commands 128",
    "gate:pre-execution": "npm test && npm run check:pre-execution-schemas && npm run check:pre-execution-package && npm run test:pre-execution-docs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "6"
  }
}
