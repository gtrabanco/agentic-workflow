{
  "name": "@gtrabanco/agentic-workflow-schema",
  "version": "2.0.0",
  "description": "Types, JSON Schema, and parser/validator for the agentic-workflow machine envelope — the fixed JSON block a driven agent turn ends with (workflow-status always; other skills under the driver-injected snippet), for programmatic orchestration.",
  "keywords": [
    "agentic-workflow",
    "agent",
    "orchestration",
    "skills",
    "schema",
    "envelope"
  ],
  "license": "MIT",
  "author": "Gabriel Trabanco <gtrabanco@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtrabanco/agentic-workflow.git",
    "directory": "packages/agentic-workflow-schema"
  },
  "homepage": "https://github.com/gtrabanco/agentic-workflow/blob/main/docs/workflow/ORCHESTRATION.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope.schema.json": "./envelope.schema.json"
  },
  "files": [
    "dist",
    "envelope.schema.json",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/index.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "6"
  }
}