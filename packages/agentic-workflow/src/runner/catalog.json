{
  "schemaVersion": 1,
  "steps": [
    "research",
    "design",
    "plan",
    "implement",
    "tests",
    "evidence",
    "review",
    "docs",
    "release"
  ],
  "relay": {
    "legs": {
      "execute": { "step": "implement" },
      "coherence-review": { "step": "review" }
    }
  },
  "activityFusion": {
    "schemaVersion": 1,
    "steps": ["design", "plan"],
    "applies_when": "risk_tier == 'standard'",
    "skipped_when": "risk_tier != 'standard'",
    "carriers": "separated",
    "gates": "separated"
  },
  "catalog": {
    "research": {
      "applies_when": "unit_type == 'feature' && scope != 'trivial'",
      "skipped_when": "unit_type in ['docs', 'chore'] || scope == 'trivial'",
      "requires_gate": false,
      "budget_tier": "cheap"
    },
    "design": {
      "applies_when": "unit_type == 'feature' && scope != 'trivial'",
      "skipped_when": "unit_type in ['docs', 'chore'] || scope == 'trivial'",
      "requires_gate": false,
      "budget_tier": "strong"
    },
    "plan": {
      "applies_when": "unit_type in ['feature', 'fix'] && scope != 'trivial'",
      "skipped_when": "unit_type in ['docs', 'chore'] || scope == 'trivial'",
      "requires_gate": false,
      "budget_tier": "cheap"
    },
    "implement": {
      "applies_when": "unit_type in ['feature', 'fix', 'chore']",
      "skipped_when": "unit_type == 'docs'",
      "requires_gate": false,
      "budget_tier": "cheap"
    },
    "tests": {
      "applies_when": "unit_type in ['feature', 'fix'] && scope != 'trivial' && tests_section != 'n/a'",
      "skipped_when": "unit_type == 'docs' || scope == 'trivial' || tests_section == 'n/a'",
      "requires_gate": false,
      "budget_tier": "strong"
    },
    "evidence": {
      "applies_when": "true",
      "skipped_when": "false",
      "requires_gate": true,
      "budget_tier": "strong"
    },
    "review": {
      "applies_when": "unit_type in ['feature', 'fix'] && scope != 'trivial'",
      "skipped_when": "unit_type == 'docs' || scope == 'trivial'",
      "requires_gate": true,
      "budget_tier": "strong"
    },
    "docs": {
      "applies_when": "unit_type == 'docs' || (unit_type in ['feature', 'fix'] && scope != 'trivial')",
      "skipped_when": "unit_type == 'chore' || scope == 'trivial'",
      "requires_gate": false,
      "budget_tier": "cheap"
    },
    "release": {
      "applies_when": "unit_type == 'feature' && scope in ['medium', 'large', 'xlarge']",
      "skipped_when": "unit_type != 'feature' || scope in ['trivial', 'small', 'xs']",
      "requires_gate": true,
      "budget_tier": "strong"
    }
  },
  "ceremonyProfile": {
    "schemaVersion": 1,
    "contract": "ceremony-profile@1",
    "stepPieces": {
      "docs": "docs-step",
      "tests": "test-policy",
      "release": "publish-gate"
    },
    "prosePieces": {
      "captures": "execute-time capture prose; no catalog step",
      "review-passes": "review-pack surface narrowing; the review step itself is never discardable"
    }
  }
}