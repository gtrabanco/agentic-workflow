      "kind": "node",
      "operator": "",
      "text": "node -e '\nconst fs = require(\"fs\");\nconst p = \"docs/workflow/GATE_INVENTORY.md\";\nlet t = fs.readFileSync(p, \"utf8\");\nconst m = t.match(/<<<<<<< HEAD\\n([\\s\\S]*?)=======\\n([\\s\\S]*?)>>>>>>> origin\\/main\\n/);\nif (!m) { console.error(\"no conflict\"); process.exit(1); }\nconst ours = m[1].split(\"\\n\").filter(Boolean);\nconst theirs = m[2].split(\"\\n\").filter(Boolean);\n// theirs: coverage-gap-join, dimension-regression, normative-surface-grammar(main)\nconst oursGrammar = ours.find(l => l.startsWith(\"normative-surface-grammar\"));\nconst theirsGrammar = theirs.find(l => l.startsWith(\"normative-surface-grammar\"));\nconst theirOther = theirs.filter(l => !l.startsWith(\"normative-surface-grammar\"));\n// union surfaces cell: theirs surfaces + ours-only additions appended\nconst cellOf = l => l.split(\"|\")[6];\nconst oSurf = cellOf(oursGrammar).split(\",\").map(s=>s.trim());\nconst tSurf = cellOf(theirsGrammar).split(\",\").map(s=>s.trim());\nconst union = tSurf.concat(oSurf.filter(s => !tSurf.includes(s)));\nconst mergedGrammar = theirsGrammar.replace(cellOf(theirsGrammar), union.join(\",\"));\nconst replacement = [...theirOther, mergedGrammar].join(\"\\n\") + \"\\n\";\nt = t.replace(m[0], replacement);\nfs.writeFileSync(p, t);\nconsole.log(\"union surfaces:\", union.length, \"| added:\", union.filter(s=>!tSurf.includes(s)));\n'",
      "expect": "node-default"
    },
