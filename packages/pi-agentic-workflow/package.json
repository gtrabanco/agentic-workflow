{
  "name": "@gtrabanco/pi-agentic-workflow",
  "version": "0.13.2",
  "description": "Pi package: canonical agentic-workflow skills, friendly slash commands, and per-command model routing.",
  "keywords": [
    "pi-package",
    "agentic-workflow",
    "pi",
    "skills",
    "workflow",
    "model-routing"
  ],
  "license": "MIT",
  "author": "Gabriel Trabanco <1969593+gtrabanco@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtrabanco/agentic-workflow.git",
    "directory": "packages/pi-agentic-workflow"
  },
  "homepage": "https://github.com/gtrabanco/agentic-workflow/tree/main/packages/pi-agentic-workflow#readme",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "bundle:skills": "bun scripts/bundle-skills.mjs",
    "clean:skills": "bun scripts/bundle-skills.mjs --clean",
    "test": "bun run bundle:skills && tsc && bun test test/*.test.mjs",
    "test:node": "bun run bundle:skills && tsc && node --test test/*.test.mjs",
    "prepublishOnly": "bun run build && bun run bundle:skills && bun run test",
    "postpack": "bun run clean:skills",
    "mutation": "bun run bundle:skills && bun scripts/mutation-check.mjs",
    "prepare": "bun run build && bun run bundle:skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6"
  }
}
