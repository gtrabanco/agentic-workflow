      "capabilities": ["Tool calling", "Reasoning control", "Vision", "Audio", "Streaming"],
      "rate_limits": { "concurrent": { "base": 5, "premium": 5 }, "tpm": 1500000 }
    },
    {
      "name": "GLM 5.3 (full)",
      "slug": "glm5.3",
      "type": "chat",
      "size": "~753B MoE",
      "context": 1000000,
      "modalities": { "input": ["text", "image", "audio", "video"], "output": ["text"] },
      "premium_required": true,
      "free_quota": 3000000000,
      "rolling_4h_limit": 400000000,
      "cost": 0,
      "credits_when_exceeded": {
        "input":  { "usd_per_1m": 1.38,  "credits_per_1m": 49.00 },
        "cached": { "usd_per_1m": 0.0295,"credits_per_1m": 1.05  },
        "output": { "usd_per_1m": 4.32,  "credits_per_1m": 154.00 }
      },
      "typical_credits_per_1m": 11.5,
      "tags": ["ZDR"],
      "capabilities": ["Tool calling", "Reasoning (always on)", "Vision", "Audio", "Video", "Streaming"],
      "note": "Premium REQUIRED. 3B gratis/mes, tope 400M/4h rolling. GLM siempre razona — `none` → minimal.",
      "rate_limits": { "concurrent": { "premium": 10 } }
    },

    // ——— MODELOS SOLO CON CREDITOS — sin cuota gratuita ———
    {
      "name": "Kimi K3.1 Pro",
      "slug": "kimi-k3.1-pro",
      "type": "chat",
      "provider": "Moonshot",
      "tags": ["ZDR", "External provider"],
      "description": "Moonshot frontier reasoning model, 1M context",
      "cost": "pay per token — ver rates abajo",
      "rates": {
        "input":       { "usd_per_1m": 2.81, "credits_per_1m": 100.00 },
        "cached":      { "usd_per_1m": 0.281, "credits_per_1m": 10.00  },
        "output":      { "usd_per_1m": 14.04, "credits_per_1m": 500.00 },
        "cache_write": { "usd_per_1m": 2.81,  "credits_per_1m": 100.00 }
      },
      "typical_credits_per_1m": 19.9,
      "tokens_per_1000_credits": 50300000
    },
    {
      "name": "Qwen3.8 Max",
      "slug": "qwen3.8-max",
      "type": "chat",
