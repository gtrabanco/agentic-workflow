      "note": "Formatos comprimidos aprovechan mejor el límite de 25MB"
    },

    // ——— IMAGE GENERATION — 100 imágenes/mes, NO cuenta en credits ———
    {
      "name": "FLUX 2 Klein",
      "slug": "flux-2-klein",
      "type": "image",
      "cost": 0,
      // 100 imágenes al mes, separadas de los créditos de chat/embedding/etc
      // Requiere inference-tier membership
      "modalities": ["text→image", "image→image"],
      "resolution_range": [256, 1536],
      "images_per_request": [1, 4],
      "monthly_limit": 100,
      "shared_with": ["qwen-image-2.1"]
    },
    {
      "name": "Qwen Image 2.1",
      "slug": "qwen-image-2.1",
      "type": "image",
      "cost": 0,
      // 100 imágenes al mes compartidas con flux-2-klein, separadas de credits
      // Requiere inference-tier membership
      "modalities": ["text→image"],
      "resolution_range": [512, 1280],
      "images_per_request": [1, 4],
      "monthly_limit": 100,
      "shared_with": ["flux-2-klein"]
    }
  ],

  // ============================================================
  // GLOSARIO
  // ============================================================
  "glossary": {
    "ZDR": "Zero Data Retention — prompts y completions NO se almacenan",
    "External provider": "Modelo servido por proveedor tercero, no GPUs de NaN",
    "credits_when_exceeded": "Rates que se aplican después de agotar la cuota gratuita mensual",
    "cost": 0,
    "free_quota": "Mensual, se reinicia con cada billing period",
    "typical_credits_per_1m": "Promedio de créditos/1M tokens en uso real combinado",
    "subscriber_discount": "5% ya aplicado en precios de packs mostrados",
    "credit_packs": "Compra única, NO se renuevan — se consumen después de agotar el período actual",
    "credits_validity_months": 6,
    "auto_recharge": "Compra automática de pack cuando se agote el balance (por defecto OFF)",
    "reasoning_effort_values": ["none", "minimal", "low", "medium", "high", "xhigh", "max"],
    "reasoning_effort_none": "Apaga razonamiento — NO funciona en GLM 5.3 (always on, `none` → minimal)",
    "inference_tier": "Tier necesario para acceder a FLUX y Qwen Image"
  }
}
