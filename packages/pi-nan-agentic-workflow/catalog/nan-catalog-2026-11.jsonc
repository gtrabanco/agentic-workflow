      "rate_limits": { "concurrent": { "base": 7, "premium": 10 }, "tpm": 1500000 }
    },
    {
      "name": "Qwen 3.8 Flash",
      "slug": "qwen3.8-flash",
      "type": "chat",
      "size": "125B MoE (6B active)",
      "context": 1000000,
      "max_output": 131072,
      "modalities": { "input": ["text", "image"], "output": ["text"] },
      "free_quota": 500000000,
      "cost": 0,
