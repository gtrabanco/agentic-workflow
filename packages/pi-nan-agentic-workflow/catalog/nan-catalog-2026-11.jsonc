    },
    {
      "name": "Hy4",
      "slug": "hy4",
      "type": "chat",
      "provider": "Tencent (Hunyuan 4)",
      "tags": ["ZDR", "External provider"],
      "description": "Hunyuan 4 agents & long docs, 1M context",
