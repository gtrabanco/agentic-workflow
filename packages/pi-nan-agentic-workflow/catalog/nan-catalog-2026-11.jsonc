// nan-catalog-2026-11.jsonc — the recorded NaN catalog/tariff snapshot the
// preset's facts derive from (issue #388 amendment 2).
//
// PROVENANCE (repo rule: third-party content carries source, author, version,
// license):
//   What:        billing/tariff/catalog dump for the NaN chat fleet — plans,
//                credit packs, per-model free allowances, credits-per-1M
//                rates, rate limits, and the provider's own model descriptions.
//   Source:      https://nan.builders/docs/models (catalog & capabilities)
//                https://nan.builders/es/model-guide (community guide by
//                @ntizar, published by NaN — cost comparisons only)
//                https://nan.builders/privacy (operator identity)
//                plus a raw tariff quote supplied to the project owner via
//                the NaN credits panel / owner channel (the JSON body below,
//                passed verbatim on 2026-11-10).
//   Author:      NaN / Helmcode S.L. (operator); guide section by @ntizar;
//                owner-supplied quote transcribed as received.
//   As of:       2026-11-10 — tariffs dated November 2026 by the provider.
//   License:     factual tariff/catalog data published by the provider's own
//                surfaces; the guide text is © Helmcode — this file quotes
//                facts, not creative prose.
//   Winner rule: where this snapshot and the provider's docs/models page
//                disagree, docs/models wins unless the owner directs
//                otherwise (known example: this quote's per-model
//                concurrency row for glm5.3 says base 7 / premium 10 — the
//                docs page confirms 7/10; the model entry's "premium only"
//                concurrency note was superseded).
//
// This file is NOT machine-consumed by the runtime: the source of truth for
// route data stays `src/preset.ts` (NAN_MODELS + PROFILE_LADDERS) and the
// prose source of truth stays the package README. `test/catalog-parity.test.mjs`
// pins the snapshot to both of them, so a provider change becomes: update THIS
// snapshot (edit in place, keep the provenance header current), then follow
// the test failures to the tier map, ladders and README rows.

{
  "rate_limits": {
    "requests_per_minute": 60,
    "concurrent": { "base_plan": 7, "premium_plan": 10 },
    "per_model": {
      "glm5.3":         { "base": 7,  "premium": 10 },
      "glm5.3-flash":   { "base": 7,  "premium": 10 },
      "deepseek-v4-flash": { "base": 7, "premium": 10 },
      "qwen3.8-flash":  { "base": 7,  "premium": 10 },
      "mimo-v2.6-flash": { "base": 5,  "premium": 5  },
      "qwen3.6":        { "base": 5,  "premium": 5  },
      "gemma4":         { "base": 5,  "premium": 5  }
    },
    "audio_embedding_rerank": "Sin límite de concurrencia",
    "tokens_per_minute": {
      "deepseek-v4-flash": 1500000,
      "mimo-v2.6-flash":   1500000,
      "qwen3.6":           1500000,
      "gemma4":            1500000
    },
    "rerank_rpm": 1000
  },

  // Suscripciones — se renuevan cada billing period
  "subscriptions": [
    { "price_eur": 70, "credits_per_month": 7000 },
    { "price_eur": 200, "credits_per_month": 20000 }
  ],

  // Credit packs — compra ÚNICA, no se renuevan, se consumen tras agotar el período
  "credit_packs": [
    { "amount": 1000, "price_eur": 24.70, "note": "5% discount ya aplicado" },
    { "amount": 5000, "price_eur": 116.85, "note": "5% discount ya aplicado" },
    { "amount": 25000, "price_eur": 550.05, "note": "5% discount ya aplicado" }
  ],
  "custom_pack": { "min_eur": 5, "max_eur": 1000 },

  base_url: "https://api.nan.builders/v1",
  helmcode_url: "https://api.helmcode.com/v1",

  // ============================================================
  // MODELOS — cada uno con "cost" en créditos
  // cost = 0 → ilimitado (o cuota fija separada)
  // cost > 0 → se pagan con credits; ver rates por detalle
  // ============================================================
  "models": [
    // ——— CHAT ILIMITADOS — sin cuota, sin costo ———
    {
      "name": "Gemma 4",
      "slug": "gemma4",
      "type": "chat",
      "size": "26B MoE (4B active)",
      "context": 262144,
      "modalities": { "input": ["text", "image"], "output": ["text"] },
      "cost": 0,
      "capabilities": ["Tool calling (XML)", "Reasoning control", "Vision", "Streaming"],
      "rate_limits": { "concurrent": { "base": 5, "premium": 5 }, "tpm": 1500000 }
    },
    {
      "name": "Qwen 3.6",
      "slug": "qwen3.6",
      "type": "chat",
      "size": "35B MoE (3B active)",
      "context": 262144,
      "modalities": { "input": ["text", "image"], "output": ["text"] },
      "cost": 0,
      "capabilities": ["Tool calling (XML)", "Reasoning control", "Vision", "Streaming", "Speculative decoding"],
      "rate_limits": { "concurrent": { "base": 5, "premium": 5 }, "tpm": 1500000 },
      "note": "Generación anterior — deepseek-v4-flash recomendado como punto de partida"
    },

    // ——— CHAT CON CUOTA GRATUITA → luego se cobran credits ———
    {
      "name": "DeepSeek V4-Flash",
      "slug": "deepseek-v4-flash",
      "type": "chat",
      "size": "305B MoE (Vision-Exp)",
      "context": 1000000,
      "modalities": { "input": ["text", "image"], "output": ["text"] },
      "free_quota": 3000000000,
      "cost": 0,
      "credits_when_exceeded": {
        "input":  { "usd_per_1m": 0.295, "credits_per_1m": 10.50 },
        "cached": { "usd_per_1m": 0.0059, "credits_per_1m": 0.21 },
        "output": { "usd_per_1m": 1.18,  "credits_per_1m": 42.00 }
      },
      "typical_credits_per_1m": 1.1,
      "tags": ["ZDR"],
      "capabilities": ["Tool calling", "Reasoning control", "Vision", "JSON mode", "json_schema"],
      "max_output": 393216,
      "rate_limits": { "concurrent": { "base": 7, "premium": 10 }, "tpm": 1500000 },
      "note": "3B tokens gratis/mes. reasoning tokens cuentan dentro del output budget"
    },
    {
