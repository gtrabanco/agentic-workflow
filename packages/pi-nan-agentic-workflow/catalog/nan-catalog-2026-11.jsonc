    // ——— EMBEDDING — ilimitado ———
    {
      "name": "Qwen3-Embedding",
      "slug": "qwen3-embedding",
      "type": "embedding",
      "cost": 0,
      "dimensions": 4096,
      "max_input": 32768,
      "precision": "BF16",
      "mteb_score": 70.58,
      "languages": "100+ (español, code)",
      "use_cases": ["Semantic search", "RAG", "Classification", "Cross-lingual similarity"]
    },

    // ——— RERANK — ilimitado ———
    {
      "name": "Rerank",
      "slug": "rerank",
      "type": "rerank",
      "cost": 0,
      "model": "Qwen3-Reranker-8B",
      "precision": "BF16",
      "languages": "100+ (español, code, cross-lingual)",
      "endpoints": ["/v1/rerank", "/v2/rerank"],
      "use_cases": ["RAG pipelines", "Cross-lingual search", "Code retrieval", "Relevance scoring"],
      "rate_limits": { "rpm": 1000 }
    },

    // ——— TTS — ilimitado ———
    {
      "name": "Kokoro",
      "slug": "kokoro",
      "type": "tts",
      "cost": 0,
      "version": "v1.0",
      "parameters": "82M",
      "voices": 67,
      "latency": "<1s",
      "available_voices": [
        { "id": "af_heart", "language": "English", "gender": "female" },
        { "id": "ef_dora",  "language": "Spanish",  "gender": "female" },
        { "id": "em_alex",  "language": "Spanish",  "gender": "male" }
