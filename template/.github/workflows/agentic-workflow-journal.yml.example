# Session-log fragment aggregator — shipped as an EXAMPLE only.
# init-workspace must ASK before installing this: consent first, then rename
# to agentic-workflow-journal.yml. A repo that opts out writes nothing and
# keeps the direct-append journal. The command it runs is forge-free: the
# documented post-receive example in template/.agentic-workflow/journal.md
# runs the same argv.
#
# BATCHED PR MODE (the default-branch rules problem): most repositories
# require changes to land through a pull request, so this workflow never
# pushes to the default branch. Each run aggregates the pending fragments on
# a branch named after the ISO week — journal-aggregate-<YYYY-Www> — which
# means ONE PR per week at most: the first run of a week opens it, later runs
# add commits to the same PR as more sessions merge their fragments. The PR
# merges itself with a MERGE COMMIT (never squash) once required checks pass;
# a repo that squashes by default must still allow merge commits for this PR.
# With no pending fragments the run is a no-op and creates nothing.
#
# Supported merge strategies for YOUR feature PRs: squash, merge-commit and
# rebase all deliver the branch's added fragment files into the default
# branch's tree, and the aggregator consumes the tip's working tree — no
# strategy switch needed.

name: journal-aggregate

on:
  schedule:
    # Mondays 06:00 UTC — one intended batch per week. Manual dispatch covers
    # the "I want to see the whole log now" case.
    - cron: "0 6 * * 1"
  workflow_dispatch: {}

# Two runs overlapping operate on the same week branch; the group serializes
# them so the second always sees the first's consumed state.
concurrency:
  group: journal-aggregate
  cancel-in-progress: false

permissions:
  contents: write # branch push and merge of the batch PR
  pull-requests: write # create the PR and enable its merge

jobs:
  aggregate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Resolve the week branch
        id: branch
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          WEEK_BRANCH="journal-aggregate-$(date -u +%G-W%V)"
          echo "branch=$WEEK_BRANCH" >> "$GITHUB_OUTPUT"
          count="$(gh pr list --head "$WEEK_BRANCH" --state open --json number --jq 'length' 2>/dev/null || echo 0)"
          echo "pr=$count" >> "$GITHUB_OUTPUT"

      # The runner crate is forge-free; the same command a post-receive hook
      # runs. The forge-free aggregator appends the pending fragments to
      # docs/LOGS.md newest-first, deletes the consumed fragments, refuses
      # anything ambiguous with exit 2 (a refusal leaves everything in place —
      # fragments are never lost, only delayed). An already-consumed fragment
      # is dropped without appending again, which makes re-running against a
      # branch that consumed earlier batches a correct no-op.
      - name: Aggregate into the week branch
        id: aggregate
        run: |
          set -euo pipefail
          BRANCH="${{ steps.branch.outputs.branch }}"
          git fetch origin main
          # The week branch may not exist yet — that is the normal first run.
          git fetch origin "$BRANCH" || true

          if [ "${{ steps.branch.outputs.pr }}" -gt 0 ]; then
            # Reuse this week's PR: continue the branch, then pull in whatever
            # fragments merged to main since. Consumed fragments restored by
            # that checkout are re-consumed without duplicating entries.
            git checkout -B "$BRANCH" "origin/$BRANCH"
            git checkout origin/main -- .agentic-workflow/journal
          else
            git checkout -B "$BRANCH" origin/main
          fi

          git config user.name "journal-bot"
          git config user.email "journal-bot@users.noreply.github.com"

          npx --yes @gtrabanco/agentic-workflow journal aggregate

          git add .agentic-workflow/journal docs/LOGS.md
          if git diff --cached --quiet; then
            echo "nothing to aggregate"
            exit 0
          fi

          git commit -m "docs(log): aggregate journal fragments ($BRANCH)"
          # A reused branch name after a closed-without-merge PR is the only
          # non-fast-forward case; the lease expects exactly what was fetched.
          git push origin "$BRANCH" || \
            git push --force-with-lease=refs/heads/"$BRANCH" origin "$BRANCH"
          echo "pushed=1" >> "$GITHUB_OUTPUT"

      # One PR per week, merged with a merge commit (no squash) — the batch of
      # journal entries is one reviewable unit on the default branch.
      - name: Merge the batch PR
        if: steps.aggregate.outputs.pushed == '1'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          BRANCH="${{ steps.branch.outputs.branch }}"

          if [ "${{ steps.branch.outputs.pr }}" -eq 0 ]; then
            WEEK="$(date -u +%G-W%V)"
            gh pr create --base main --head "$BRANCH" \
              --title "docs(log): aggregate journal fragments ($WEEK)" \
              --body "Auto-generated weekly journal batch (week $WEEK). One merge commit, never squashed."
          fi

          # Auto-merge fires once the required checks pass; if the repository
          # does not have auto-merge enabled, try to merge directly instead.
          if ! gh pr merge "$BRANCH" --auto --merge --delete-branch; then
            gh pr merge "$BRANCH" --merge --delete-branch
          fi
